# Copy to .env for local development. Never commit .env.
# Compose reads devops/.env automatically. Every value has a default in
# docker-compose.yml, so this file is only needed to change something.

# Schema owner: used only by the migrate step.
POSTGRES_USER=fincore
POSTGRES_PASSWORD=fincore_local_dev
POSTGRES_DB=fincore
POSTGRES_PORT=5432

# Least-privilege login for the API, worker and fincorectl (member of
# fincore_app). Created on the database volume's first start only: to
# change it later, recreate the volume (down -v) or ALTER ROLE by hand.
APP_DB_USER=fincore_api
APP_DB_PASSWORD=fincore_api_local_dev

# Published on 127.0.0.1 only.
API_PORT=8080
API_METRICS_PORT=9090
WORKER_METRICS_PORT=9091
API_DB_MAX_CONNS=10

# Image tag and the version reported in logs and fincore_build_info.
FINCORE_VERSION=dev

# For running the binaries directly on the host (go run ./cmd/api):
HTTP_ADDR=:8080
DATABASE_URL=postgres://fincore:fincore_local_dev@localhost:5432/fincore?sslmode=disable
